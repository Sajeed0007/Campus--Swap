# Backend environment variables.
#
# Copy to .env for local use (.env is gitignored). In AWS, set these as task
# definition / Beanstalk environment properties, and keep the secrets in
# AWS Secrets Manager or SSM Parameter Store rather than plain env vars.
#
# Every name below is already wired into src/main/resources/application.yml.

# --- Profile -----------------------------------------------------------------
# "prod" switches ddl-auto to validate, disables SQL logging, and activates
# JwtSecretValidator, which refuses to start on the committed dev secret.
SPRING_PROFILES_ACTIVE=prod

# --- Database (Amazon RDS for PostgreSQL) ------------------------------------
# Do not include credentials in the URL; use the dedicated variables.
DB_URL=jdbc:postgresql://your-instance.abcdefg.us-east-1.rds.amazonaws.com:5432/campusswap
DB_USERNAME=campusswap_app
DB_PASSWORD=

# With SPRING_PROFILES_ACTIVE=prod this is forced to "validate", so the schema
# must already exist. Create it once with "update" on a throwaway boot, or
# manage it with a migration tool.
# JPA_DDL_AUTO=validate

# --- JWT ---------------------------------------------------------------------
# Must be at least 32 bytes. Generate with:
#   openssl rand -hex 32
# Startup fails in the prod profile if this is absent, too short, or still the
# development default.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Must be the
# exact HTTPS origin Amplify serves, with no trailing slash. A mismatch here is
# the most common cause of a deployed frontend that "does nothing" on submit.
APP_CORS_ALLOWED_ORIGINS=https://main.d1234abcd.amplifyapp.com

# --- Server ------------------------------------------------------------------
SERVER_PORT=8080

# --- Logging -----------------------------------------------------------------
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
